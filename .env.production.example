DATABASE_URL=postgresql://prod_user:****@prod-db.rds.amazonaws.com:5432/aegis_prod
REDIS_URL=redis://:password@prod-redis.elasticache.amazonaws.com:6379
NODE_ENV=production
LOG_LEVEL=warn
JWT_SECRET=****
JWT_REFRESH_SECRET=****
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3001
GRPC_PORT=50051
ELASTICSEARCH_URL=http://prod-elasticsearch:9200
PROMETHEUS_URL=http://prod-prometheus:9090
CORS_ORIGINS=https://yourdomain.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_SALT_ROUNDS=12
AUDIT_ENABLED=true
METRICS_ENABLED=true
TRACING_ENABLED=true
TRACING_SAMPLE_RATE=0.1