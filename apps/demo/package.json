{
  "name": "@aegis/demo",
  "version": "0.1.0",
  "private": true,
  "description": "AEGIS Demo Application - Showcase all packages",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx src/prisma/seed.ts"
  },
  "dependencies": {
    "@aegis/core": "workspace:*",
    "@aegis/audit": "workspace:*",
    "@aegis/observability": "workspace:*",
    "@aegis/resilience": "workspace:*",
    "@aegis/cache": "workspace:*",
    "@aegis/validation": "workspace:*",
    "@aegis/queue": "workspace:*",
    "@aegis/security": "workspace:*",
    "@grpc/grpc-js": "^1.9.0",
    "@grpc/proto-loader": "^0.7.0",
    "@prisma/client": "^5.8.0",
    "express": "^4.18.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.0",
    "bullmq": "^5.1.0",
    "zod": "^3.22.0",
    "jsonwebtoken": "^9.0.0",
    "winston": "^3.11.0",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.11.0",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "tsx": "^4.7.0",
    "prisma": "^5.8.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "@types/jest": "^29.5.0"
  }
}