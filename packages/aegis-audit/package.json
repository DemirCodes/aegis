{
  "name": "@aegis/audit",
  "version": "0.1.0",
  "description": "AEGIS Audit - Audit trail, GDPR compliance and data erasure for Node.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
