  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.11.0",
    "@types/express": "^4.17.0",
    "prisma": "^7.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "@types/jest": "^29.5.0"
  },
  "peerDependencies": {
    "@prisma/client": "^7.0.0",
    "express": "^4.18.0"
  },
  "publishConfig": {
    "access": "public"
