{
  "name": "aegis",
  "version": "0.1.0",
  "private": true,
  "description": "🛡️ AEGIS - Production-Ready Microservices Framework for Node.js",
  "keywords": [
    "microservices",
    "nodejs",
    "typescript",
    "grpc",
    "audit",
    "observability",
    "resilience",
    "circuit-breaker",
    "caching",
    "validation",
    "queue",
    "security",
    "gdpr"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "prepare": "husky install",
    "docker:build": "docker build -t aegis-demo ./apps/demo",
    "docker:up": "docker-compose -f ./apps/demo/docker-compose.yml up -d",
    "docker:down": "docker-compose -f ./apps/demo/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "turbo": "^1.12.0",
    "typescript": "^5.3.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "prettier": "^3.2.0",
    "@changesets/cli": "^2.27.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@8.14.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}